{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.context-map/v1",
  "type": "object",
  "required": ["schema_version", "routes"],
  "properties": {
    "schema_version": { "const": "temple.context-map/v1" },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "summary",
          "paths",
          "tags",
          "positions",
          "work_items",
          "read_when",
          "owner_position",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
          "kind": {
            "enum": [
              "product-spec",
              "technical-spec",
              "adr",
              "domain",
              "module",
              "runbook",
              "test",
              "documentation",
              "other"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "positions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "work_items": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^WI-(?:[0-9]{4,}|[0-9]{8}-[A-F0-9]{10})$" }
          },
          "read_when": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "owner_position": { "type": ["string", "null"] },
          "status": { "enum": ["active", "deprecated"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
