{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.init/v1",
  "type": "object",
  "required": ["schema_version", "project", "naming_mode", "agents"],
  "properties": {
    "schema_version": { "const": "temple.init/v1" },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "naming_mode": { "enum": ["manual", "ai-suggested"] },
    "agents": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["display_name", "positions"],
        "properties": {
          "id": { "type": "string", "pattern": "^agent-[a-z0-9][a-z0-9-]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "positions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
