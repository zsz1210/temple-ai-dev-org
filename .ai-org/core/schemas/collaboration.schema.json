{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.collaboration/v1",
  "type": "object",
  "required": ["schema_version", "profile", "coordination_backend", "principals", "sponsorships", "memberships"],
  "properties": {
    "schema_version": { "const": "temple.collaboration/v1" },
    "profile": { "enum": ["solo", "collaborative", "high-assurance"] },
    "coordination_backend": { "const": "repository" },
    "principals": { "type": "array" },
    "sponsorships": { "type": "array" },
    "memberships": { "type": "array" },
    "large_scale_validation": {
      "type": "object",
      "required": ["status", "plan"],
      "properties": {
        "status": { "enum": ["not_run", "planned", "passed", "failed"] },
        "plan": { "type": "string", "minLength": 1 },
        "tested_revision": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
