{
  "schema_version": "temple.experiment-tool-policy/v1",
  "network_access": false,
  "approval_policy": "never",
  "allowed_command_prefixes": [
    ["rg"],
    ["sed"],
    ["node"],
    ["npm", "test"],
    ["git", "status"],
    ["git", "diff"],
    ["git", "rev-parse"],
    ["git", "log"],
    ["git", "ls-tree"],
    ["git", "-C", "gateway", "status"],
    ["git", "-C", "gateway", "diff"],
    ["git", "-C", "gateway", "rev-parse"],
    ["git", "-C", "gateway", "log"],
    ["git", "-C", "gateway", "ls-tree"],
    ["git", "-C", "catalog", "status"],
    ["git", "-C", "catalog", "diff"],
    ["git", "-C", "catalog", "rev-parse"],
    ["git", "-C", "catalog", "log"],
    ["git", "-C", "catalog", "ls-tree"],
    ["git", "-C", "orders", "status"],
    ["git", "-C", "orders", "diff"],
    ["git", "-C", "orders", "rev-parse"],
    ["git", "-C", "orders", "log"],
    ["git", "-C", "orders", "ls-tree"],
    ["git", "-C", "notifications", "status"],
    ["git", "-C", "notifications", "diff"],
    ["git", "-C", "notifications", "rev-parse"],
    ["git", "-C", "notifications", "log"],
    ["git", "-C", "notifications", "ls-tree"],
    ["git", "-C", "coordinator", "status"],
    ["git", "-C", "coordinator", "diff"],
    ["git", "-C", "coordinator", "rev-parse"],
    ["git", "-C", "coordinator", "log"],
    ["git", "-C", "coordinator", "ls-tree"]
  ],
  "forbidden_actions": [
    "external-write",
    "package-install",
    "deployment",
    "publication",
    "credential-access"
  ]
}
