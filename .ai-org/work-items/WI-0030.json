  "scope": [
    "Correct the WI-0029 Quality NO-GO by ensuring durable command records and Dashboard history never retain or reconstruct the complete instruction, including ordinary one-character and short instructions.",
    "Preserve transient pre-send confirmation and exact provider delivery after explicit confirmation; do not execute a real Codex task, add remote control, push, release, publish, or expand command scope."
  ],
  "acceptance_criteria": [
