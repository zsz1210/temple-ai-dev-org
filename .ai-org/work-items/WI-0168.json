  "id": "WI-0168",
  "title": "Publish npm only from GitHub Releases with OIDC",
  "state": "done",
  "owner_position": "engineering_manager",
  "assigned_agent_id": "agent-mog",
  "created_at": "2026-09-05T00:03:48.903Z",
  "updated_at": "2026-09-05T00:25:57.230Z",
  "scope": [
    "Replace interactive npm publication with one GitHub Release-published workflow using npm Trusted Publishing",
    "Bind every publication to the Release tag, matching package version, exact GitHub Release tarball asset, and a fresh pack digest",
    "Route prereleases to next and stable releases to latest; PRs, pushes, merges, and manual dispatch remain non-publishing"
  ],
  "acceptance_criteria": [
    "Only a published GitHub Release can trigger the npm publish job; ordinary repository events cannot",
    "The workflow fails closed on tag, version, release-channel, npm CLI, archive, or digest mismatch and uses OIDC without an npm token",
    "Automated tests cover release routing and artifact validation, and human-facing documentation explains one-time setup and the first live-proof boundary"
  ],
  "affected_paths": [
    ".github/workflows/publish-npm.yml",
