  "scope": [
    "Expose the live Temple Dashboard through an explicitly trusted tailnet HTTPS reverse proxy while the control plane remains bound to 127.0.0.1 and every remote request remains read-only."
  ],
  "acceptance_criteria": [
    "A trusted exact private-viewer host with Tailscale identity headers can load a redacted live Dashboard and refresh stream from a tablet, while Inbox data, Agent Commands, session secrets, raw journal events, and every mutation route remain unavailable.",
    "The optional Tailscale integration is version-pinned, license-reviewed, documented, testable without a live tailnet, refuses Funnel or public binding, and has an explicit stop/rollback path."
  ],
