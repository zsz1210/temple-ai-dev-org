  "scope": [
    "Provide a reusable versioned experiment manifest and runner with persistent wave checkpoints, aggregate Token and time ceilings, zero retry, bounded concurrency, per-repository telemetry, and path allowlists.",
    "Aggregate already-qualified repository usage samples into a cross-repository longitudinal report without granting lifecycle, savings, cost, quality, or routing authority.",
    "Use the runner for the retained four-repository local commerce rehearsal after exact-candidate verification."
  ],
  "acceptance_criteria": [
    "Pure runner tests prove hard-stop behavior for turn, attempt, retry, concurrency, per-turn Token, aggregate Token, wall-clock, disk, and path-diff limits.",
    "A four-participant fixture can qualify ten distinct completed Work Items across at least two task shapes without requiring ten items inside one repository.",
    "Fresh init, schema validation, full verification, Doctor, and Independent QA pass; no live model turn starts during this Work Item."
  ],
