  "scope": [
    "Retire Node.js 22 from the active public compatibility contract, require Node.js 24 or later, and replace the hosted full-suite matrix with one bounded Node.js 24 repository gate while retaining full and browser verification locally."
  ],
  "acceptance_criteria": [
    "Active package metadata, bootstrap metadata, README files, and current planning documentation require Node.js 24 or later; historical evidence remains unchanged.",
    "GitHub Actions uses one Node.js 24 job with a five-minute ceiling and does not run the full integration suite or Management Console browser suite on ordinary pushes or pull requests.",
    "Local contributor guidance and tests preserve npm run verify as the full behavioral gate and npm run test:browser for UI changes; CI contract tests prevent reintroducing the hosted matrix or long suites."
  ],
