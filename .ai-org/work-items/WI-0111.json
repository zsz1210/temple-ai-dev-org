  "scope": [
    "Replace blanket shell-metacharacter rejection with a deterministic quote-aware scanner that accepts literal operator characters inside safe quoted arguments while rejecting executable shell control outside quotes, without evaluating or normalizing the command."
  ],
  "acceptance_criteria": [
    "The exact persisted WI-0110 rg search action with a single-quoted alternation passes.",
    "Unquoted or post-quote pipelines, command separators, redirects, command substitutions, multiline commands, unclosed quotes, and malformed actions fail closed.",
    "The live runner preflight exercises representative quoted-safe and top-level-unsafe actions through the shared helper.",
    "Focused tests, full repository verification, Doctor, and exact-revision Independent QA pass without model generation."
  ],
