  "schema_version": "temple.work-item/v1",
  "id": "WI-0049",
  "title": "Make Temple Workspace status language human-readable",
  "state": "done",
  "owner_position": "engineering_manager",
  "assigned_agent_id": "agent-mog",
  "created_at": "2026-08-31T03:43:07.298Z",
  "updated_at": "2026-08-31T08:50:17.794Z",
  "scope": [
    "Refine the human-facing Temple Workspace so open work, disclosure behavior, lifecycle status, and update freshness are understandable without exposing internal telemetry jargon in the primary reading path."
  ],
  "acceptance_criteria": [
    "Work item rows have a visible disclosure affordance and remain keyboard-operable, read-only details.",
    "Primary work-item summaries use concise human status labels while technical provenance, freshness, revision, and runtime evidence remain available inside details.",
    "Open work separates in-progress, testing, release-decision, planned, and blocked states without the ambiguous Queued and waiting group.",
    "A healthy refresh shows only one quiet last-updated timestamp; stale or failed refreshes remain prominent and disable loopback mutations.",
    "Prominent Workspace copy is audited for operator-facing language while canonical IDs and exact evidence remain traceable.",
    "Responsive layout, private read-only boundaries, focused tests, full verification, and browser review pass."
  ],
