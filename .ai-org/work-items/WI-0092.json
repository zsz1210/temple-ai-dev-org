{
  "schema_version": "temple.work-item/v1",
  "id": "WI-0092",
  "title": "Make Usage observation optional, managed, and gap-aware",
  "state": "done",
  "owner_position": "engineering_manager",
  "assigned_agent_id": "agent-mog",
  "created_at": "2026-09-02T00:31:26.149Z",
  "updated_at": "2026-09-02T01:38:42.922Z",
  "scope": [
    "Define clone-local Off, On-demand, and Managed local Observer modes without making Codex observation a framework prerequisite.",
    "Provide a fail-closed macOS managed-local service path that runs the read-only LAN console and Codex Observer without storing machine settings in Git.",
    "Expose observation mode, retained-history limits, and post-start capture gaps without attributing account-wide activity to Work Items.",
    "Preserve automatic registration for Temple Provider-owned tasks and document the existing explicit registration path for externally created Codex tasks."
  ],
  "acceptance_criteria": [
    "An initialized project remains fully usable with observation Off and records missing usage as unknown rather than zero.",
    "On-demand and Managed local modes are distinguishable in machine-readable status and the human Usage view; retained observations survive provider shutdown.",
    "Managed local installation is clone-local, macOS-only, explicit, reversible, does not retain prompts or hidden reasoning, and does not expose mutation routes on the LAN viewer.",
    "Work completed outside an active correlated observation window is reported as a coverage gap that cannot be reconstructed at Work Item level.",
    "Focused service, attribution, CLI, responsive browser, and full verification pass at the exact candidate revision."
  ],
