{
  "schema_version": "temple.work-item/v1",
  "id": "WI-0078",
  "title": "Make the public README visual and human-first",
  "state": "done",
  "owner_position": "engineering_manager",
  "assigned_agent_id": "agent-mog",
  "created_at": "2026-08-31T23:23:26.433Z",
  "updated_at": "2026-08-31T23:46:59.230Z",
  "scope": [
    "Research human-friendly open-source README and system-context diagram patterns, then translate the applicable principles into an original Temple overview visual.",
    "Replace the engineering-oriented operating-loop graphic with a compact product story that explains human direction, Temple coordination, people-and-AI execution, repository truth, and trustworthy delivery without presenting runtime layers as mandatory.",
    "Keep English, Japanese, and Traditional Chinese README structure aligned; add one concise real-use walkthrough, an after-initialization explanation, a truthful shipped/experimental/planned summary, and direct contribution and security links.",
    "Do not copy third-party artwork, publish externally, add a design vendor dependency, or add a Management Console screenshot before its separate implementation and verification work is complete."
  ],
  "acceptance_criteria": [
    "A first-time non-specialist can explain what Temple does, where human authority remains, and why repository evidence matters after viewing the first README screen.",
    "The overview is an original repository-owned SVG that is legible in GitHub light and dark themes, remains readable at narrow widths, and has localized accessible text for English, Japanese, and Traditional Chinese readers.",
    "All three READMEs share the same section structure and claims, retain Early Alpha limitations, and link to existing deeper documentation rather than duplicating internal architecture.",
    "README asset paths and links resolve, SVGs parse, the repository verification suite passes, and visual review covers desktop-width and narrow rendered output."
  ],
