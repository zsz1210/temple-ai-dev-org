  "id": "WI-0140",
  "title": "Measure and enforce Context Capsule route adherence",
  "state": "done",
  "owner_position": "engineering_manager",
  "assigned_agent_id": "agent-mog",
  "created_at": "2026-09-04T02:17:43.020Z",
