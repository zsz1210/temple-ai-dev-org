  "scope": [
    "Make one telemetry journal instance assign cursors, deduplicate identities, append, compact, checkpoint, and notify listeners through a single ordered mutation queue.",
    "Preserve the archived WI-0056 live journal as immutable evidence and change no Provider protocol or retry behavior."
  ],
  "acceptance_criteria": [
    "A deterministic concurrent burst of unique events produces strictly increasing unique cursors and reopens successfully from disk.",
    "Concurrent duplicate identities retain one record and one duplicate result without collision or duplicate cursor.",
    "Close waits for queued appends and rejects later writes; existing privacy, compaction, second-writer, and Dashboard behavior remain passing.",
    "Full verification and distinct-Identity Independent QA pass without any model generation or external release."
  ],
