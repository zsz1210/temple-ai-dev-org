  "scope": [
    "Replace the unsupported Node 20 floor with a verified Node 22 and Node 24 LTS compatibility contract; keep Node 26 as a future compatibility lane until it reaches LTS.",
    "Reduce the npm artifact to an explicit runtime and public-documentation allowlist while keeping publication disabled.",
    "Harden CI action provenance and add practical OSS contribution, security, ownership, and issue intake files without changing repository visibility or publishing a release."
  ],
  "acceptance_criteria": [
    "package.json, bootstrap metadata, public setup guidance, and CI agree on Node 22 and Node 24 LTS support.",
    "npm pack dry-run is enforced by an automated allowlist check, includes the CLI runtime and public documentation, and excludes repository self-host state, tests, examples, and generated evidence.",
    "GitHub Actions are pinned to full commit SHAs, run the supported Node LTS matrix, and preserve least-privilege permissions and fail-closed verification behavior.",
    "Public contributor, security, ownership, pull-request, and issue-intake guidance separates maintainership from release authority and warns against secrets or private project data.",
    "The retained MIT decision and public-alpha boundary are documented; repository verification passes before release-gate closeout, while visibility, npm publication, tag creation, and GitHub settings remain external follow-up gates."
  ],
