  "scope": [
    "Define requested turn reasoning, Provider-observed thread reasoning, and Provider-observed effective turn reasoning as distinct bounded concepts.",
    "Preserve legacy task compatibility while preventing dashboards, usage reports, and runtime evidence from presenting a thread-level value as a turn-effective value.",
    "Update human-facing operations documentation and the approved dark Workspace without changing remote-control authority."
  ],
  "acceptance_criteria": [
    "A Provider-owned launch requesting max while thread/start reports xhigh records requested=max, observed thread=xhigh, effective turn=null, and an explicit compatibility-source label.",
    "Usage attribution and the Team surface expose all available reasoning provenance without guessing an effective turn value.",
    "Legacy task registries remain schema-valid; focused tests, full verification, runtime visual review, and Independent QA pass."
  ],
