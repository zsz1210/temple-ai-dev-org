{
  "schema_version": "temple.work-item/v1",
  "id": "WI-0070",
  "title": "Automate Skill candidate proposals with human activation",
  "state": "done",
  "owner_position": "engineering_manager",
  "assigned_agent_id": "agent-mog",
  "created_at": "2026-08-31T13:45:10.940Z",
  "updated_at": "2026-08-31T14:19:50.000Z",
  "scope": [
    "Add deterministic promotion-candidate detection, evidence-backed Skill Proposal records, approval decisions, automatic authoring Work Item creation after approval, Observer/Now attention, and capability indexing after a Skill is authored. Keep activation human-approved and do not silently promote low-risk Skills."
  ],
  "acceptance_criteria": [
    "Validated repeated Practices are surfaced as reviewable Skill candidates without mutating canonical learning state.",
    "A Tech Lead can record a bounded Skill Proposal with trigger, non-trigger, authority, risk, dependencies, alternatives, evidence, and overlap findings.",
    "A human can approve, reject, or defer a proposal; approval creates exactly one project-owned Skill-authoring Work Item and never creates or activates a Skill directly.",
    "Observer and status expose pending Skill approvals through the existing attention surface, while generated views remain non-authoritative.",
    "Schema validation, focused tests, full npm verification, and independent QA cover duplicate approval, stale evidence, unsafe names, routing overlap, and rollback boundaries."
  ],
