{
  "schema_version": "temple.work-item/v1",
  "id": "WI-0152",
  "title": "Add auditable self-hosting evidence profiles",
  "state": "done",
  "owner_position": "engineering_manager",
  "assigned_agent_id": "agent-mog",
  "created_at": "2026-09-04T10:48:07.802Z",
  "updated_at": "2026-09-04T11:23:57.594Z",
  "scope": [
    "Define and implement auditable self-hosting evidence profiles that preserve useful repository evidence, normalize local environment identifiers, keep credentials and raw runtime data local, audit public readiness, clean package-facing examples, and document the capability. Excludes changing GitHub visibility, rewriting Git history, changing collaborator permissions, publishing npm, or creating a formal release."
  ],
  "acceptance_criteria": [
    "Private, public, and restricted evidence profiles have versioned project-owned policy and schema contracts with a safe default.",
    "A deterministic read-only public-readiness audit classifies blocked, review-required, and allowed evidence without echoing detected secret values.",
    "Public evidence retains lifecycle, QA, release, model-routing, token-budget, Credits, reset, and experiment-approval facts while current and future machine paths, private endpoints, credentials, live account snapshots, and raw runtime telemetry follow explicit normalization or local-only rules.",
    "Current package-facing documentation no longer contains maintainer-specific absolute paths, LAN addresses, or Tailnet hostnames; Git history is not rewritten.",
    "Human-facing English documentation explains Auditable Self-Hosting and Public Evidence Profile, with concise aligned README treatment in English, Japanese, and Traditional Chinese.",
    "Automated tests, schema validation, Doctor, package inspection, and full repository verification pass; Independent QA is performed by an Agent Identity distinct from the Developer."
  ],
