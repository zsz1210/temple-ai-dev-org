  "scope": [
    "Make per-turn and whole-program timeout tests deterministic under slow hosted runners by separating the non-target hard limit without changing production behavior."
  ],
  "acceptance_criteria": [
    "The per-turn timeout test cannot exhaust the program limit first, the program timeout test cannot exhaust the per-turn limit first, and both still assert the exact stop code.",
    "Repeated focused runs, full local verification, and hosted CI pass under the unchanged 10-minute workflow limit."
  ],
