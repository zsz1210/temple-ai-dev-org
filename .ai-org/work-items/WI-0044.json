  "id": "WI-0044",
  "title": "Redesign Dashboard navigation and operator information architecture",
  "state": "done",
  "owner_position": "engineering_manager",
  "assigned_agent_id": "agent-mog",
  "created_at": "2026-08-30T23:42:02.351Z",
  "updated_at": "2026-08-31T08:50:16.342Z",
  "scope": [
    "Replace the long single-page Dashboard with a responsive operational cockpit organized around Now, Execution, Usage, System, and History while preserving truthful evidence, privacy boundaries, and local-only mutation authority."
  ],
  "acceptance_criteria": [
    "A persistent desktop sidebar and compact mobile/tablet navigation expose Now, Execution, Usage, System, and History as directly reachable views.",
    "The default Now view lets an operator identify current health, highest-priority action, active work, and human decisions without understanding Temple internals.",
    "Execution visibly maps Agent to Position to Work Item to Codex task and observed model, preserving unknown states when evidence is absent.",
    "Usage collapses insufficient evidence into a concise truthful state and exposes deeper analysis only when observations exist.",
    "Private LAN and Tailscale viewers remain redacted and read-only; Human Inbox and Agent Commands remain local-only.",
    "Desktop, tablet, and mobile browser validation has no console errors, inaccessible navigation, or horizontal overflow."
  ],
