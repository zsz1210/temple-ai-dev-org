  "scope": [
    "Read normalized provider Token-usage observations from the active telemetry journal and bounded local archives so a Control Plane rebuild does not erase historical usage from Temple Workspace.",
    "Keep archives immutable, telemetry observational, and raw prompt or content payloads outside the usage projection."
  ],
  "acceptance_criteria": [
    "Usage report and Workspace include deduplicated normalized usage observations from active and eligible archived journals.",
    "Malformed, unsafe, oversized, or conflicting archive inputs fail closed per file without breaking the active Dashboard and expose bounded coverage diagnostics.",
    "The preserved WI-0056 Provider observation reappears as 23,433 total Tokens after rebuild without another model call.",
    "Automated tests cover archive discovery, validation, deduplication, conflict handling, privacy boundaries, and active-only compatibility."
  ],
