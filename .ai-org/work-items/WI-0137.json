  "scope": [
    "Add stage- and purpose-bound Context Capsules that route only relevant sources without copying source bodies or expanding authority.",
    "Expose content-addressed source size and category measurements so context, cached-input, latency, and storage trade-offs can be analyzed without guessing.",
    "Document the boundary across single-repository, coordinator-led multi-repository, and autonomous federation use."
  ],
  "acceptance_criteria": [
    "Context resolution defaults to the Work Item lifecycle stage and supports explicit primary, integration, and recovery purposes.",
    "Generated capsules contain deterministic digests and byte-level source manifests while retaining no source bodies, prompts, hidden reasoning, or credentials.",
    "Existing context-map/v1 project files remain readable; new optional stage and purpose constraints are validated and tested.",
    "Single-repository and multi-repository fixtures demonstrate that unrelated stage context is not selected and that unscoped legacy routes remain compatible.",
    "Human documentation explains the routing, observability, fallback, and authority boundaries using measured WI-0136 evidence."
  ],
