  "scope": [
    "Define a reproducible Temple-versus-minimal and model-profile matched evaluation protocol, including representative cases, quality rubric, measurement fields, resource ceilings, telemetry prerequisites, stop rules, and an explicit approval boundary before any model generation."
  ],
  "acceptance_criteria": [
    "The protocol separates framework-overhead comparison from model-profile comparison and never attributes causality across those factors.",
    "Every case has matched inputs, repository revisions, tool access, model settings, QA rubric, and declared exclusions.",
    "A numerical preflight derives proposed Token, wall-clock, disk, retry, and concurrency limits from retained Temple evidence rather than guesswork.",
    "No model generation, external spend, external write, deployment, release, publication, or optional service activation occurs in this Work Item.",
    "The next executable slice and its required human approval are unambiguous."
  ],
