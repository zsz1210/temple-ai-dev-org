{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.control-plane-config/v1",
  "type": "object",
  "required": ["schema_version", "state_directory", "server", "retention", "privacy", "providers"],
  "properties": {
    "schema_version": { "const": "temple.control-plane-config/v1" },
    "state_directory": { "type": ["string", "null"], "minLength": 1 },
    "server": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": { "const": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": ["max_events"],
      "properties": {
        "max_events": { "type": "integer", "minimum": 100, "maximum": 1000000 }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "required": ["stalled_after_ms", "pending_for_ms", "cooldown_ms", "token_budget"],
      "properties": {
        "stalled_after_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 },
        "pending_for_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 },
        "cooldown_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 },
        "token_budget": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["capture_raw_payloads", "max_data_bytes", "redact_keys"],
      "properties": {
        "capture_raw_payloads": { "const": false },
        "max_data_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "redact_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "enabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["repository", "fixture", "codex-app-server", "github"] },
          "enabled": { "type": "boolean" },
          "options": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
